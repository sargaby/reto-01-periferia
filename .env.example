# Puerto HTTP; vacío usa 3000.
PORT=
LLM_PROVIDER=openai
# Para una demostración local sin claves: LLM_PROVIDER=demo.
# Fecha controlada opcional para vigencias; vacío usa la fecha UTC actual.
REFERENCE_DATE=
# Solo en el backend. Modelo compatible con Chat Completions, tool calling,
# max_completion_tokens y JSON mode. No se elige un modelo por defecto.
OPENAI_API_KEY=
OPENAI_MODEL=
# Google AI Studio (Gemini Developer API). Solo obligatorio si LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_MAX_ITERATIONS=25
LLM_MAX_SESSION_TOKENS=100000
LLM_MAX_TOTAL_TOKENS=1000000
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_MS=30000
MAX_SESSIONS=100
